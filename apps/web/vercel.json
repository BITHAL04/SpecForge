{
  "buildCommand": "cd ../.. && pnpm install && pnpm --filter @specforge/web build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install",
  "regions": ["iad1"],
  "rewrites": [
    {
      "source": "/api/backend/:path*",
      "destination": "https://specforge-api.up.railway.app/api/v1/:path*"
    }
  ]
}
